---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Ryan Wu - Business and Technical Leader",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi, I’m Ryan. A business and technical leader. Full stack JavaScript & iOS developer, co-founder of EREO Creatives.
		</p>
		<h2>Latest Tech Stack</h2>
		<p>
			<a
				data-theme="dark"
				data-layers="1,2,3,4"
				data-stack-embed="true"
				target="_blank"
				rel="noopener noreferrer"
				href="https://embed.stackshare.io/stacks/embed/8b9628760edd398075388339d1fada"
			></a>
			<script async src="https://cdn1.stackshare.io/javascripts/client-code.js" charset="utf-8"></script>
		</p>
	</div>
</PageLayout>
